# Matchmaking Service Environment Configuration

# Server Configuration
PORT=3003
NODE_ENV=development

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Matchmaking Configuration
RATING_TOLERANCE=200
MAX_WAIT_TIME=30000
QUEUE_CHECK_INTERVAL=2000
MAX_QUEUE_TIME=60000

# Rating System Configuration
DEFAULT_RATING=1200
MIN_RATING=0
MAX_RATING=3000
RATING_CHANGE_K=32
PROVISIONAL_GAMES=20

# Game Lifecycle Service URL
GAME_SERVICE_URL=http://localhost:3002
USER_SERVICE_URL=http://localhost:3001

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/matchmaking-service.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
