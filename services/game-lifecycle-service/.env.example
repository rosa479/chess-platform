# Game Lifecycle Service Environment Configuration

# Server Configuration
PORT=3002
NODE_ENV=development

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Game Configuration
MAX_MOVE_TIME=300000
DRAW_OFFER_TIMEOUT=30000
RESIGNATION_CONFIRMATION_TIME=5000
MAX_GAME_DURATION=7200000

# Time Control Configuration
DEFAULT_TIME_CONTROL=blitz
DEFAULT_INCREMENT=0

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/game-lifecycle-service.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
